# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries

# Fortran module files
*.mod

# Compiled Static libraries


# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga


# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

!Plugins/DLSS/Binaries/ThirdParty
!Plugins/QimeraCompose/Intermediate/
!Plugins/QimeraCompose/Intermediate/Build/
!Plugins/QimeraCompose/Intermediate/Build/Win64/
!Plugins/QimeraCompose/Intermediate/Build/Win64/**/Inc/
!Plugins/QimeraCompose/Intermediate/Build/Win64/**/Inc/**

# Cache files for the editor to use
DerivedDataCache/*
/Plugins/QimeraCompose/Content/QimeraSwitcher/ScenePreviews
/Plugins/QimeraCompose/Content/QimeraSwitcher/ScenePreviews
/Content/QimeraIO/MediaFiles/CustomInputFiles
.idea/.idea.QimeraCompose5/.idea/workspace.xml
.idea/.idea.QimeraCompose5/.idea/copilotDiffState.xml
.idea/.idea.QimeraCompose5/.idea/workspace.xml
.idea/.idea.QimeraCompose5/.idea/copilotDiffState.xml
Plugins/QimeraCompose/.allow-source-build
